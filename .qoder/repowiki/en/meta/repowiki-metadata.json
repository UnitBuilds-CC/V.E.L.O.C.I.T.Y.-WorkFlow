build:
  rust:
    toolchain: "stable"
    workspace: true
    crates: 15
    allocator: "jemalloc (non-MSVC targets)"
    feature_flags:
      otel: "velocity-server-bootstrap --features otel (OpenTelemetry OTLP export)"
      
  typescript:
    node_version: "22+"
    packages:
      - "velocity-classic-ts"
      - "velocity-sdk-typescript"
      - "velocity-runtime-typescript"

deployment:
  docker:
    compose_files:
      - "docker-compose.yml"
      - "docker-compose.e2e.yml"
      - "docker-compose.fair-bench.yml"
      - "docker-compose.flavors.yml"
    services:
      - "velocity-server"
      - "velocity-embedded-server"
      - "velocity-classic-server"
      - "dbos"
      - "restate"
      - "temporal"
      
  kubernetes:
    manifests: "deploy/k8s/"
    helm: "deploy/helm/velocity/"
    kustomize: "deploy/kustomize/"

ci:
