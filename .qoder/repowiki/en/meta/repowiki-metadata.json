# Velocity Workflow Repowiki Metadata
# Generated: 2026-08-17
# Last updated: After VCTP Production Hardening — all 22 requirements across 6 phases complete

project:
  name: "V.E.L.O.C.I.T.Y. WorkFlow"
  full_name: "Versatile Engine for Low-latency Orchestration, Coordination, and Intelligent Transaction Yield"
  description: "High-performance workflow engine ecosystem with multiple deployment flavors"
  repository: "https://github.com/UnitBuilds-CC/V.E.L.O.C.I.T.Y.-WorkFlow"
  license: "MIT"

workspace:
  resolver: "2"
  profile_release:
    opt_level: 3
    lto: true
    codegen_units: 1
    panic: "abort"
  profile_ci:
    inherits: "release"
    lto: false
    codegen_units: 16
  crates:
    # Core engine
    - name: "velocity-workflow-core"
      role: "core abstractions and FFI slab engine"
    - name: "velocity-workflow-engine"
      role: "workflow engine implementation with WAL, PG adapter, advisory locking, DurabilityConfig (engine.rs)"
    - name: "velocity-workflow-daemon"
      role: "background daemon process"

    # Protocol
    - name: "velocity-nmcp-protocol"
      role: "NMCP binary protocol: frame parsing, shmem IPC, WebSocket transport"

    # Server bootstrap
    - name: "velocity-server-bootstrap"
      role: "shared server init, auth, rate limiting, audit, tracing, mTLS"

    # Server flavors
    - name: "velocity-workflow-server"
      role: "gRPC server with WAL persistence (original flavor)"
    - name: "velocity-classic"
      role: "Classic engine library crate (NMCP router)"
    - name: "velocity-classic-server"
      role: "Classic server binary — NMCP shmem + WebSocket, replaces TypeScript"
    - name: "velocity-embedded"
      role: "Embedded engine library crate (NMCP router + PostgreSQL)"
    - name: "velocity-embedded-server"
      role: "Embedded server binary — NMCP shmem + WebSocket + PostgreSQL"

    # Benchmarks and tools
    - name: "velocity-bench"
      role: "HTTP benchmark tool with workload adapters"
    - name: "velocity-dev-server"
      role: "development server with hot reload"
    - name: "velocity-test-framework"
      role: "integration test framework"
    - name: "prod-bench"
      path: "bench-suite/prod-bench"
      role: "production benchmark suite (gRPC + HTTP clients)"
    - name: "velocity-bench-server"
      path: "bench-suite/velocity-bench-server"
      role: "gRPC benchmark service server"

  # VCTP tools and sidecar (separate workspace)
  tools:
    - name: "vctp-sidecar"
      path: "tools/vctp-sidecar"
      role: "VCTP sidecar proxy — TLS/crypto offload with ECDH session + XOR cipher"
    - name: "vctp-cli"
      path: "tools/vctp-cli"
      role: "Python CLI for VCTP server operations (health, start, signal, query, cancel)"
    - name: "vctp-wireshark"
      path: "tools/vctp-wireshark"
      role: "Wireshark Lua dissector for VCTP packet inspection"
    - name: "vctp-openapi"
      path: "tools/vctp-openapi"
      role: "OpenAPI 3.0.3 spec generator from VCTP protocol definitions"

flavors:
  - name: "Velocity Server"
    type: "single-binary"
    protocol: "gRPC (BenchmarkService)"
    transport: "gRPC (HTTP/2) — original, still used for bench-suite"
    persistence: "WAL (group-commit)"
    port: 17234
    throughput: "43.6 ops/s"
    memory: "98.76 MiB"
    binary: "velocity-workflow-server"
    
  - name: "Velocity Embedded"
    type: "embedded"
    protocol: "NMCP (shmem + WebSocket)"
    transport: "NMCP shmem for local IPC, WebSocket for remote"
    persistence: "WAL + PostgreSQL (per-step journal)"
    port: 8084
    throughput: "61.25 ops/s"
    memory: "1.25 MiB + 68 MiB PG"
    binary: "velocity-embedded-server"
    
  - name: "Velocity Classic"
    type: "rust-server"
    protocol: "NMCP (shmem + WebSocket)"
    transport: "NMCP shmem for local IPC, WebSocket for remote"
    persistence: "WAL + optional PostgreSQL"
    port: 8083
    throughput: "61.54 ops/s"
    memory: "9.23 MiB"
    binary: "velocity-classic-server"
    note: "Replaced TypeScript engine with Rust (commit 2bae043)"

security:
  authentication:
    - "API Key (X-API-Key header or Bearer token)"
    - "JWT (HS256/RS256) with zero-downtime key rotation"
  rate_limiting: "Token bucket per-client IP (DashMap-based)"
  audit: "Structured audit logging for all API calls"
  tls: "mTLS support via rustls (cert + key PEM files)"
  scanning: "Trivy container security scanning in CI"
  headers: "Security headers on every HTTP response: X-Content-Type-Options: nosniff, X-Frame-Options: DENY, Cache-Control: no-store"

tracing:
  framework: "OpenTelemetry"
  export: "OTLP (optional, to Jaeger/Tempo/Grafana)"
  spans:
    - "workflow.execute"
    - "step.persist"
    - "signal.deliver"
  log_formats:
    - "compact (human-readable)"
    - "json (structured, recommended for production)"
  sampling: "Configurable sample rate"

coordination:
  mechanism: "PostgreSQL advisory locks"
  features:
    - "Leader election (one instance runs periodic tasks)"
    - "Workflow locking (one instance per workflow)"
    - "Migration locking (one instance runs schema migrations)"
  lock_key_space:
    leader_election: "0xVE00_xxxx_xxxx_xxxx"
    workflow_processing: "0xVE10_xxxx_xxxx_xxxx"
    schema_migrations: "0xVE20_0000_0000_0000"

durability:
  configurable: true
  struct: "DurabilityConfig { sync_steps: u32, flush_interval_ms: u64, direct_execution: bool }"
  modes:
    - name: "strict()"
      sync_steps: 0
      description: "fsync every step — maximum safety, financial transactions"
    - name: "batched(N, ms)"
      sync_steps: "N (configurable)"
      description: "fsync every N steps or every ms — balanced, order processing"
    - name: "async_only(ms)"
      sync_steps: "u32::MAX"
      description: "background fsync only — max throughput, event processing"
  direct_execution:
    enabled: "with_direct_execution() builder method"
    behavior: "Skip task queue enqueue on step completion"
    use_case: "Embedded/engine-local workloads where caller drives the loop"
    anti_pattern: "Distributed worker-pool patterns where external workers poll task queue"
    performance: "Eliminates 2 Mutex locks + condvar signal per step"
  default: "strict() with direct_execution = false"
  method: "complete_step_durable() replaces complete_step_sync()"
  bench_cli_flags:
    - "--sync-steps (0=strict, N=batched)"
    - "--flush-interval-ms (time-based fsync floor)"
    - "--direct-execution (skip task queue enqueue)"

sdks:
  - language: "TypeScript"
    path: "velocity-sdk-typescript"
    status: "production"
    vctp: "velocity-sdk-typescript/src/vctp-transport.ts (358 lines)"
    
  - language: "Python"
    path: "velocity-sdk-python"
    status: "production"
    vctp: "velocity-sdk-python/velocity_workflow/vctp.py (316 lines)"
    
  - language: "Go"
    path: "velocity-sdk-go"
    status: "production"
    vctp: "velocity-sdk-go/vctp/client.go (451 lines)"
    
  - language: "Java"
    path: "velocity-sdk-java"
    status: "beta"

competitors:
  - name: "Temporal"
    throughput: "35.9 ops/s"
    memory: "563 MiB"
    
  - name: "DBOS"
    throughput: "59.59 ops/s"
    memory: "63.23 MiB"
    
  - name: "Restate"
    throughput: "41.14 ops/s"
    memory: "200.36 MiB"

vctp:
  protocol: "VCTP (Velocity Transfer Protocol) — zero-copy UDP-based RPC"
  wire_format:
    header_size: 28
    magic: "0x50544356"
    checksum: "CRC32"
    max_payload: 65479
    default_port: 9090
  features:
    - "Circuit breaker (Closed/Open/HalfOpen)"
    - "Per-client rate limiting (token bucket)"
    - "JWT + API key authentication"
    - "Idempotency checking"
    - "Heartbeat (30s interval, 90s eviction)"
    - "Graceful drain (preStop hook + 503)"
    - "Reorder buffer (BTreeMap in-order delivery)"
    - "AIMD congestion control"
    - "Packet fragmentation/reassembly"
    - "Prometheus metrics export"
    - "OpenTelemetry tracing spans"
  gateways:
    - "WebSocket-to-VCTP gateway (592 lines)"
    - "HTTP-to-VCTP ingress with Swagger UI at /docs (666 lines)"
    - "VCTP sidecar proxy with ECDH + XOR cipher (474 lines)"
  benchmarks:
    full_stack_dispatch: "9,052 ops/s (UDP + WAL + DB)"
    full_stack_start_workflow: "7,375 ops/s (UDP + WAL + DB)"
    wal_durability_write: "7,962 wf/s"
    wal_crash_recovery: "43,113 wf/s"
  tests:
    engine_tests: 2103
    vctp_tests: 38
    sidecar_tests: 6
    total: 2109

