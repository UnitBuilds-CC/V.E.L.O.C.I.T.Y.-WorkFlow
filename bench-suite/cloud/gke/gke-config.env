# GKE Benchmark Configuration
#
# Cluster: velocity-bench-k8s
# Region: us-east1-b
# Nodes: 1x e2-standard-4 (4 vCPU, 16GB RAM)
#
# Usage:
#   export KUBECONFIG=$(pwd)/../../.kube/config
#   kubectl apply -k ../../kustomize/overlays/gke-standard/

# Artifact Registry
REGISTRY=us-east1-docker.pkg.dev/velocity-live-test-001/velocity

# Images
VELOCITY_RUNTIME_IMAGE=${REGISTRY}/velocity-runtime:latest
VELOCITY_CLASSIC_IMAGE=${REGISTRY}/velocity-classic:latest
VELOCITY_EMBEDDED_IMAGE=${REGISTRY}/velocity-embedded:latest
BENCH_CLIENT_IMAGE=${REGISTRY}/bench-client:latest
TEMPORAL_BENCH_IMAGE=${REGISTRY}/temporal-bench:latest

# Namespace
NAMESPACE=benchmark

# Resource profiles
# Standard: 1 CPU, 1Gi per engine
# Stress: 2 CPU, 2Gi per engine
