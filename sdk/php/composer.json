{
    "name": "velocity/workflow-sdk",
    "description": "PHP SDK for the VELOCITY-WorkFlow engine — calls the native engine via FFI or gRPC",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "UnitBuilds",
            "email": "ian@unitbuilds.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "grpc/grpc": "^1.42",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Velocity\\SDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Velocity\\SDK\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
